# For Streamlit Community Cloud: paste into App settings -> Secrets.
# Add the key(s) you have. With AGENT_ACCESS_CODE set, visitors must type the
# code before the app uses your key; without it, anyone can run the agent on it.
GEMINI_API_KEY = "your-gemini-key"
# ANTHROPIC_API_KEY = "sk-ant-..."
AGENT_ACCESS_CODE = "choose-a-code-to-share-with-interviewers"
